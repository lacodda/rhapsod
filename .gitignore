# Rust
/target/
**/*.rs.bk

# Node (web frontend and docs site)
node_modules/
dist/
.astro/

# Environment
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# The SQLite file and everything the server writes: state, never source.
/data/

# A local library to read while developing. The real one is published from
# the author's vault (ADR 0002) and is not part of this repository.
/content/

# Copies of a stand brought here by tools/stand/backup.*: the reader's
# database and the stand's settings, with its password hash. The default
# place for them is inside this checkout, and this repository is public.
/backups/

# What the road gate leaves behind: traces and screenshots of a failed run.
# CI uploads them as an artifact; locally they are read and thrown away.
/web/test-results/
/web/playwright-report/
