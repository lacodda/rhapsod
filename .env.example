# Copy to .env for local development. The real .env is never committed.

# Directory of markdown files with YAML frontmatter: the library. Required.
# Point it at a published copy of your vault, or at a folder with a few
# files in it while developing.
RHAPSOD_CONTENT_DIR=./content

# SQLite file holding everything the reader remembers: progress, notes,
# review schedules. Optional; this is the default. `mode=rwc` creates the
# file on first start, and the server creates the directory.
RHAPSOD_DATABASE_URL=sqlite://data/rhapsod.db?mode=rwc

# Address the HTTP server binds to. Optional; defaults to 0.0.0.0:8084.
RHAPSOD_ADDR=127.0.0.1:8084

# Directory holding the built SPA. Optional; defaults to ./web/dist, which
# is what `pnpm build` produces. In development Vite serves the SPA itself
# on :5173 and proxies /api here, so the default can stay unbuilt.
# RHAPSOD_WEB_DIR=./web/dist

# Argon2 hash of the reading password. Optional: unset leaves the stand open,
# which is how one reader on a home network usually runs it. Generate one with
# `rhapsod hash` and paste the whole PHC string here, quoted - it contains $.
# RHAPSOD_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'

# Log filter (tracing-subscriber EnvFilter syntax). Optional.
RUST_LOG=rhapsod=debug,tower_http=info

# --- Publishing -------------------------------------------------------------
# Read by the scripts in tools/, never by the server: publish-content.* copies
# a library onto a stand and asks it to reindex, export-marks.* brings back
# what the reader made of it. Leave them unset unless you publish from this
# machine.

# The local library directory to publish.
# RHAPSOD_PUBLISH_SRC=./library

# The ssh host to publish to, as ssh resolves it.
# RHAPSOD_PUBLISH_HOST=pi

# The directory on that host to publish into: what RHAPSOD_CONTENT_DIR points
# at over there.
# RHAPSOD_PUBLISH_DEST=/srv/rhapsod/content

# Base URL of the running server: called to reindex after a copy, and asked
# for the export. Optional; defaults to http://localhost:8084.
# RHAPSOD_PUBLISH_URL=http://pi:8084

# The plan of topics, published beside the library as topics.md so the reader
# can ask for something that has not been written yet. Optional: without it the
# stand simply offers nothing to ask for. Usually somewhere else entirely from
# the library, which is why it is its own variable and not a file inside SRC.
# RHAPSOD_PUBLISH_TOPICS=./plan.md

# Where tools/export-marks.* writes the export document. Optional; this is the
# default. The file holds the reading state, the notes and the quotes as they
# were at one moment, for a script to write back into the vault.
# RHAPSOD_EXPORT_TO=./rhapsod-export.json

# The reading password, in plain text - not the hash. Only needed to export
# from a locked stand, where everything about the reading is behind a session;
# an open stand needs no value here. Single-quote a passphrase with spaces.
# RHAPSOD_PASSWORD='a good passphrase'
