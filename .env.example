# Copy to .env for local development. The real .env is never committed.

# Directory of markdown files with YAML frontmatter: the library. Required.
# Point it at a published copy of your vault, or at a folder with a few
# files in it while developing.
RHAPSOD_CONTENT_DIR=./content

# SQLite file holding everything the reader remembers: progress, notes,
# review schedules. Optional; this is the default. `mode=rwc` creates the
# file on first start, and the server creates the directory.
RHAPSOD_DATABASE_URL=sqlite://data/rhapsod.db?mode=rwc

# Address the HTTP server binds to. Optional; defaults to 0.0.0.0:8084.
RHAPSOD_ADDR=127.0.0.1:8084

# Directory holding the built SPA. Optional; defaults to ./web/dist, which
# is what `pnpm build` produces. In development Vite serves the SPA itself
# on :5173 and proxies /api here, so the default can stay unbuilt.
# RHAPSOD_WEB_DIR=./web/dist

# Log filter (tracing-subscriber EnvFilter syntax). Optional.
RUST_LOG=rhapsod=debug,tower_http=info
