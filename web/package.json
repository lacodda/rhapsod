{
  "name": "rhapsod-web",
  "version": "0.15.9",
  "description": "A self-hosted reader for a markdown library: progress, notes and spaced repetition",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
