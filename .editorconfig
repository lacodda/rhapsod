root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Four spaces in Rust: rustfmt's default, which rustfmt.toml leaves alone.
[*.rs]
indent_size = 4

# The documentation site keeps the tabs its Starlight scaffold is written in.
[docs/site/**.{mjs,ts}]
indent_style = tab
